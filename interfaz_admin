class _Line extends CustomPainter {
  final List<double> data;
  final double t;
  _Line(this.data, this.t);

  @override
  void paint(Canvas canvas, Size size) {
    for (var i = 0; i <= 4; i++) {
      canvas.drawLine(Offset(0, size.height * i / 4), Offset(size.width, size.height * i / 4), Paint()..color = C.platinum);
    }
    final hi = data.reduce((a, b) => a > b ? a : b), lo = data.reduce((a, b) => a < b ? a : b), dx = size.width / (data.length - 1);
    final p = [for (var i = 0; i < data.length; i++) Offset(dx * i, size.height * .9 - (data[i] - lo) / (hi - lo) * size.height * .78)];
    final line = Path()..moveTo(p.first.dx, p.first.dy);
    for (var i = 0; i < p.length - 1; i++) {
      final mx = (p[i].dx + p[i + 1].dx) / 2;
      line.cubicTo(mx, p[i].dy, mx, p[i + 1].dy, p[i + 1].dx, p[i + 1].dy);
    }
    final box = Offset.zero & size;
    canvas.save();
    canvas.clipRect(Rect.fromLTWH(0, 0, size.width * t, size.height)); // revelado progresivo
    canvas.drawPath(
      Path.from(line)..lineTo(size.width, size.height)..lineTo(0, size.height)..close(),
      Paint()..shader = LinearGradient(begin: Alignment.topCenter, end: Alignment.bottomCenter, colors: [C.wine.withValues(alpha: .28), C.wine.withValues(alpha: 0)]).createShader(box),
    );
    canvas.drawPath(
      line,
      Paint()..style = PaintingStyle.stroke..strokeWidth = 3.2..strokeCap = StrokeCap.round..shader = const LinearGradient(colors: [C.wine, C.red]).createShader(box),
    );
    canvas.restore();
    if (t > .98) {
      canvas.drawCircle(p.last, 6, Paint()..color = C.white);
      canvas.drawCircle(p.last, 6, Paint()..style = PaintingStyle.stroke..strokeWidth = 3..color = C.red);
    }
  }

  @override
  bool shouldRepaint(covariant _Line o) => o.t != t || o.data != data;
}

